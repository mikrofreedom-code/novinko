# Supabase (nový projekt alebo zdieľaný — rozhodneme)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# Flux Schnell cez Replicate
REPLICATE_API_TOKEN=

# Modely pre AI vrstvy (Gateway ich číta odtiaľto, agent ich nepozná)
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6

# Poistka: kým true, články čakajú na ručné schválenie
MANUAL_APPROVAL=true

# Výber dôležitosti (0-100): vyššie = menej, dôležitejších článkov
IMPORTANCE_BAR=42

# Odolnosť + náklady
DAILY_BUDGET_USD=5
AI_MAX_RETRIES=4
AI_TIMEOUT_MS=60000
MAX_RETRIES=3

# Zberový režim: false = zbiera+vyberá ale nepíše (0 nákladov). true = píše.
AI_ENABLED=true
FEED_MAX_AGE_DAYS=7
FEED_MAX_ITEMS=20
WEB_MARKET_MIN_PCT=10  # trhové správy na webe len pri pohybe >= toto %

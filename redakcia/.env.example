# Supabase (nový projekt alebo zdieľaný — rozhodneme)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API
ANTHROPIC_API_KEY=

# Flux Schnell cez Replicate
REPLICATE_API_TOKEN=

# Modely pre AI vrstvy (Gateway ich číta odtiaľto, agent ich nepozná)
MODEL_CHEAP=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6

# Poistka: kým true, články čakajú na ručné schválenie
MANUAL_APPROVAL=true

# Výber dôležitosti (0-100): vyššie = menej, dôležitejších článkov
IMPORTANCE_BAR=42
# Rovnaký subjekt + typ udalosti sa znovu nenavrhne počas tohto okna.
TOPIC_COOLDOWN_H=48
# Jedna dávková AI porada pre Svet; false = iba deterministické skóre/cooldown.
CHIEF_EDITOR_AI_ENABLED=true
CHIEF_EDITOR_AI_MAX_CANDIDATES=8

# Horoskop sa večer pripraví na zajtra a ráno iba aktivuje z lokálnej cache.
HOROSKOP_GENERATOR_HOUR=6
HOROSKOP_PREPARE_HOUR=20
HOROSKOP_IMAGE_URL=https://novinko.sk/assets/horoskop-zverokruh.webp
# Daily market recap disabled; opt in explicitly to resume it.
MARKET_RECAP_ENABLED=false
# Horoskop píše Sonnet 5 aj v zberovom režime (nezávislé od AI_ENABLED).
# false = len bezplatný núdzový zásobník.
HOROSKOP_AI_ENABLED=true

# Odolnosť + náklady
DAILY_BUDGET_USD=5
AI_MAX_RETRIES=4
AI_TIMEOUT_MS=60000
MAX_RETRIES=3

# Zberový režim: false = zbiera+vyberá ale nepíše (0 nákladov). true = píše.
AI_ENABLED=true
FEED_MAX_AGE_DAYS=4
QUEUE_RETENTION_DAYS=5
FEED_MAX_ITEMS=20
WEB_MARKET_MIN_PCT=10  # trhové správy na webe len pri pohybe >= toto %
MAX_ARTICLES_PER_RUN=2  # koľko článkov za beh (hodinu)
ALLOW_PUBLISH=false  # true = automatické publikovanie na web

# Telegram auto-broadcast (zverejnené články idú aj do kanála). Prázdne = vypnuté.
TELEGRAM_BOT_TOKEN=      # z @BotFather
TELEGRAM_CHAT_ID=        # @nazovkanala alebo -1001234567890
SITE_URL=https://novinko.netlify.app

# Súkromný prehľad správ (scripts/digest.mjs) — SAMOSTATNÝ bot, iný token než
# vyššie, aby sa neplietol so schvaľovaním ✅/❌. Prázdne = skript len vypíše
# do konzoly, nič sa neposiela. Voliteľné, netýka sa produkčnej pipeline.
TELEGRAM_DIGEST_BOT_TOKEN=
TELEGRAM_DIGEST_CHAT_ID=
DIGEST_LOOKBACK_HOURS=24
DIGEST_SECTION_CAP=20
DIGEST_TRANSLATE=false   # true = preklad nadpisov cez Haiku (~$0,012/beh), nezávisle od AI_ENABLED

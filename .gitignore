# Zjednotené pravidlá oboch pôvodných projektov (novinko-clean + novinko-redakcia).
# Poznámka: redakcia/ má vlastný .gitignore, ktorý platí navyše k tomuto.

# Netlify lokálne (vrátane dev Postgresu a build cache)
.netlify

# Závislosti
node_modules

# Premenné prostredia — NIKDY do gitu
.env
.env.*
.env.backup
!.env.example

# Behové súbory pipeline
logs/
.pipeline.lock

# Generované stránky (vznikajú pri každom behu pipeline)
prehlad.html
redakcia/web/

# Systémové
.DS_Store

# Výstup buildu webu (skladá ho scripts/build-site.sh)
_site/

# Pôvodné bannery od používateľa (3× ~1,9 MB PNG). Do gitu idú len zmenšené
# WebP verzie v assets/reklama/, ktoré build zverejňuje — rovnaký prístup ako
# pri zaloha-fotiek/ v redakcii. Lomka na začiatku je dôležitá: bez nej by
# pravidlo vylúčilo aj assets/reklama/, teda práve tie súbory, čo idú na web.
/reklama/
